# .vercelignore - liste blanche : tout ce qui n'est pas explicitement re-inclus ci-dessous n'est PAS envoye a Vercel.
# Pourquoi : `vercel --prod --force` envoie le dossier de travail entier (fichiers non suivis compris) et, des qu'un .vercelignore existe,
# .gitignore n'est PAS applique (constate le 06/10 : /.claude/settings.local.json et /.agents/ sont servis alors qu'ils sont dans .gitignore).
# Regle d'or : un nouveau fichier du site doit etre AJOUTE ICI (re-inclus) ; un fichier de travail n'a rien a faire : il est exclu par defaut.
# Verifie par scan des references (pages, sw.js, manifests, middleware.js, vercel.json, api/) : scan_refs.py ; simulation : sim_vercelignore.py.
/*

# --- code serveur et configuration (vercel.json et package.json ne sont pas SERVIS : Vercel les lit/exclut du statique) ---
!/api/
!/middleware.js
!/vercel.json
!/package.json
!/package-lock.json

# --- tampon de deploiement : deploy.sh l'ecrit a la racine puis le relit sur le domaine a l'etape 3/3 (sans lui, 3/3 echoue) ---
!/deploy-stamp.txt

# --- pages du site et des demos ---
!/index.html
!/fr.html
!/demo-private.html
!/kaizenology.html
!/wominds.html
!/partner-demo.html
!/lka-demo.html
!/phci-demo.html
!/yellowwood-demo.html
!/icp-setup.html
!/icp-setup-fr.html
!/privacy.html
!/privacy-fr.html
!/legal/

# --- scripts, PWA, SEO, icones et images utilises par les pages ---
!/shared.js
!/sw.js
!/manifest.json
!/manifest-kaizenology.json
!/manifest-lka.json
!/manifest-phci.json
!/manifest-private.json
!/manifest-wominds.json
!/manifest-yellowwood.json
!/robots.txt
!/sitemap.xml
!/apple-touch-icon.png
!/icon-192.png
!/icon-512.png
!/icon-maskable-512.png
!/corridor-favicon.svg
!/hero.png
!/logos/

# --- A CONFIRMER PAR THOMAS : servis aujourd'hui, non references par les pages. Commenter une ligne = ne plus la publier ---
!/assets/
!/corridor_capsule_1_animated_NEW.html
!/corridor_capsule_2_animated_NEW.html
!/corridor_capsule_3_animated_NEW.html
!/corridor_capsule_4_animated_NEW.html
!/corridor_capsule_5_animated_NEW.html
!/Capsules Marketing + voiceover/
!/lka-demo-p2test.html
!/phci-demo-p2test.html
!/yellowwood-demo-p2test.html
