#!/usr/bin/env node
const { execSync } = require('child_process');
const { loadConfig, scanContent } = require('../scripts/check-vendor-names-core.js');

const { names, targetFiles } = loadConfig();

let stagedFiles;
try {
  stagedFiles = execSync('git diff --cached --name-only', { encoding: 'utf8' }).split('\n').filter(Boolean);
} catch { process.exit(0); }

const relevant = targetFiles.filter(f => stagedFiles.includes(f));
if (relevant.length === 0) process.exit(0);

let allHits = [];
for (const f of relevant) {
  let staged;
  try { staged = execSync(`git show :"${f}"`, { encoding: 'utf8' }); }
  catch { continue; }
  allHits = allHits.concat(scanContent(staged, names, f));
}

if (allHits.length > 0) {
  console.error(`\nBLOCKED [pre-commit] : ${allHits.length} occurrence(s) fournisseur trouvee(s) dans le contenu staged.\n`);
  for (const h of allHits) console.error(`  ${h.file}:${h.line} [${h.name}] ${h.text}`);
  console.error('\nCorrige avant de commit. Bypass deconseille : git commit --no-verify\n');
  process.exit(1);
}
console.log(`[pre-commit] check-vendor-names OK sur ${relevant.length} fichier(s).`);
process.exit(0);
